import snake.snake

describe "snake" {
    test "si esta mirando hacia arriba, al moverse avanza una posicion hacia arriba" {
        snake.posicion(new Position(x=2, y=2))
        snake.apply()

        assert.equals(snake.position(), new Position(x=2, y=3))
    }

    test "si esta mirando hacia la derecha, al moverse avanza una posicion hacia la derecha" {
        snake.posicion(new Position(x=2, y=2))
        snake.moverseALaDerecha()
        snake.apply()

        assert.equals(snake.position(), new Position(x=3, y=2))
    }
}